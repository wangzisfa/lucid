{
  "name": "lucid-agent-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Next.js backend running the Claude Agent SDK loop for the Lucid Terminal React Native client. Exposes /api/agent/run (SSE) and /api/agent/approve.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.153",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4"
  }
}
