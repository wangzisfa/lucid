{
  "name": "lucid-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "mobile:export": "node scripts/mobile-export.mjs",
    "android:demo": "node scripts/mobile-export.mjs && LUCID_MOBILE_DEMO=1 cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.153",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.5.4"
  }
}
